NODE_ENV=development
PORT=5004

# Shared PostgreSQL service used by both marketplace and logistics modules.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kourier_boyz
MARKETPLACE_PG_POOL_MAX=10

# Used only by the one-time migrate:mongo-to-postgres command.
SOURCE_MONGO_URI=
SOURCE_MONGO_DATABASE=
JWT_SECRET=replace_with_a_random_jwt_secret
REFRESH_SECRET=replace_with_a_different_random_refresh_secret
PHONE_ENCRYPTION_KEY=replace_with_a_32_byte_hex_key

# Kourier Boyz application origins.
FRONTEND_URL=http://localhost:5173
SELLER_PANEL_URL=http://localhost:5174
ADMIN_PANEL_URL=http://localhost:5176
TRACKING_DOMAIN=http://localhost:5177
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# Internal courier service bridge. The secret must match the logistics backend.
KOURIER_BOYZ_LOGISTICS_API_URL=http://localhost:4000/api
KOURIER_BOYZ_LOGISTICS_API_KEY=replace_with_the_marketplace_service_api_key
KOURIER_BOYZ_LOGISTICS_WEBHOOK_SECRET=replace_with_a_shared_internal_webhook_secret

# Cloudflare R2 storage dedicated to Kourier Boyz marketplace assets.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kourier-boyz-marketplace
R2_PUBLIC_URL=https://cdn.kourierboyz.com

# Google sign-in.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Transactional email and SMS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Kourier Boyz <no-reply@kourierboyz.com>
SIGMO_SMS_API_URL=https://your-sms-provider.example/api
SIGMO_SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=KOURIER
SMS_ENTITY_ID=your_entity_id
SMS_TEMPLATE_ID=your_template_id
SMS_ROUTE=transactional

# Payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional external shipping-provider compatibility adapter.
SHIPMOZO_API_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
SHIPMOZO_WEBHOOK_SECRET=

# WebAuthn and two-factor identity.
WEBAUTHN_ORIGIN=http://localhost:5176
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kourier Boyz
TWO_FACTOR_ISSUER=Kourier Boyz

KOURIER_BOYZ_GSTIN=
KOURIER_BOYZ_COMPANY_ADDRESS_LINE1=
KOURIER_BOYZ_COMPANY_ADDRESS_LINE2=
