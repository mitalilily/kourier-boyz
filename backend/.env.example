NODE_ENV=production
PORT=4000

# One PostgreSQL service for both backend modules.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kourier_boyz
# Leave false for PostgreSQL on this host; set true for providers requiring TLS.
PG_SSL=false

# Marketplace authentication.
JWT_SECRET=replace_with_a_random_marketplace_jwt_secret
REFRESH_SECRET=replace_with_a_random_marketplace_refresh_secret
PHONE_ENCRYPTION_KEY=replace_with_a_32_byte_hex_key

# Logistics authentication.
ACCESS_TOKEN_SECRET=replace_with_a_random_logistics_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_random_logistics_refresh_secret

# Public application origins.
FRONTEND_URL=http://localhost:5173
SELLER_PANEL_URL=http://localhost:5174
ADMIN_PANEL_URL=http://localhost:5176
TRACKING_DOMAIN=http://localhost:5173/track
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5176
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5176
ADMIN_URL=http://localhost:5176

# Public backend origin. Do not include /api.
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Marketplace-to-logistics bridge. The URL defaults to this unified process.
KOURIER_BOYZ_LOGISTICS_API_URL=http://localhost:4000/api
KOURIER_BOYZ_LOGISTICS_API_KEY=replace_with_a_logistics_api_key
KOURIER_BOYZ_LOGISTICS_WEBHOOK_SECRET=replace_with_a_shared_webhook_secret

# Transactional email. Both backend modules use this Hostinger mailbox.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@kourierboyz.com
SMTP_PASS=replace_with_the_mailbox_password
SMTP_FROM=Kourier Boyz <support@kourierboyz.com>
EMAIL_FROM=support@kourierboyz.com
EMAIL_FROM_NAME=Kourier Boyz
GOOGLE_SMTP_USER=support@kourierboyz.com
GOOGLE_SMTP_PASSWORD=replace_with_the_mailbox_password

# Private Cloudflare R2 storage shared by both backend modules. Each module uses
# a separate prefix inside the Kourier Boyz bucket.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kourier-boyz-prod
PROD_BUCKET=kourier-boyz-prod
R2_MARKETPLACE_PROJECT_PREFIX=kourier-boyz
R2_MARKETPLACE_PREFIX=marketplace
R2_PROJECT_PREFIX=kourier-boyz/logistics
R2_DELIVERY_BASE_URL=https://api.kourierboyz.com/api/marketplace/files/object
R2_URL_SIGNING_SECRET=generate_a_random_secret_with_at_least_32_characters
R2_UPLOAD_TIMEOUT_MS=30000

# See marketplace/.env.example and logistics/.env.example for provider-specific
# Razorpay, SMS, courier, Shopify, and WooCommerce credentials.
